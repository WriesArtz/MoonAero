diff --git a/app/src/main/java/com/limelight/aero/AeroApi28.java b/app/src/main/java/com/limelight/aero/AeroApi28.java
new file mode 100644
index 0000000..622ae38
--- /dev/null
+++ b/app/src/main/java/com/limelight/aero/AeroApi28.java
@@ -0,0 +1,45 @@
+package com.limelight.aero;
+
+import android.annotation.TargetApi;
+import android.content.ContentResolver;
+import android.graphics.ImageDecoder;
+import android.graphics.drawable.AnimatedImageDrawable;
+import android.graphics.drawable.Drawable;
+import android.net.Uri;
+
+import java.io.IOException;
+
+/** Animated GIF / WebP support. Only touched on Android 9 (API 28) and newer. */
+@TargetApi(28)
+final class AeroApi28 {
+    private AeroApi28() {}
+
+    static Drawable decode(ContentResolver resolver, Uri uri, final int maxSide) throws IOException {
+        ImageDecoder.Source source = ImageDecoder.createSource(resolver, uri);
+        return ImageDecoder.decodeDrawable(source, new ImageDecoder.OnHeaderDecodedListener() {
+            @Override
+            public void onHeaderDecoded(ImageDecoder decoder, ImageDecoder.ImageInfo info, ImageDecoder.Source src) {
+                int big = Math.max(info.getSize().getWidth(), info.getSize().getHeight());
+                if (big > maxSide) {
+                    decoder.setTargetSampleSize((big + maxSide - 1) / maxSide);
+                }
+            }
+        });
+    }
+
+    /** Starts or pauses the animation if the drawable is animated; returns whether it was. */
+    static boolean setPlaying(Drawable drawable, boolean play) {
+        if (!(drawable instanceof AnimatedImageDrawable)) {
+            return false;
+        }
+        AnimatedImageDrawable animated = (AnimatedImageDrawable) drawable;
+        animated.setRepeatCount(AnimatedImageDrawable.REPEAT_INFINITE);
+        if (play) {
+            animated.start();
+        }
+        else {
+            animated.stop();
+        }
+        return true;
+    }
+}
diff --git a/app/src/main/java/com/limelight/aero/AeroBackdrop.java b/app/src/main/java/com/limelight/aero/AeroBackdrop.java
new file mode 100644
index 0000000..29f4a85
--- /dev/null
+++ b/app/src/main/java/com/limelight/aero/AeroBackdrop.java
@@ -0,0 +1,134 @@
+package com.limelight.aero;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.DisplayMetrics;
+
+/**
+ * The blurred picture of the background that glass panels show through them.
+ *
+ * It is a tiny (~190 px) screen-sized render of sky + wallpaper (first frame for GIFs and
+ * videos) + dimming, blurred once. Each glass drawable then draws the part of it that lies
+ * behind itself, which is what makes it look like frosted glass without per-view blur work.
+ */
+final class AeroBackdrop {
+    private AeroBackdrop() {}
+
+    private static final int LONG_SIDE = 192;
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+
+    private static volatile Bitmap bitmap;
+    private static volatile int windowWidth = 1;
+    private static volatile int windowHeight = 1;
+    private static String key = "";
+    private static int generation = 0;
+
+    static Bitmap bitmap() {
+        return bitmap;
+    }
+
+    static int windowWidth() {
+        return windowWidth;
+    }
+
+    static int windowHeight() {
+        return windowHeight;
+    }
+
+    /**
+     * Makes sure the backdrop matches the palette and screen size. The sky version is ready
+     * immediately; the wallpaper version replaces it later, and {@code onChanged} then runs
+     * on the main thread so views can redraw.
+     */
+    static void ensure(final Context context, final AeroPalette palette, final Runnable onChanged) {
+        DisplayMetrics dm = context.getResources().getDisplayMetrics();
+        final int w = Math.max(1, dm.widthPixels);
+        final int h = Math.max(1, dm.heightPixels);
+        String newKey = palette.top + ":" + palette.mid + ":" + palette.bottom + ":" + palette.blur
+                + ":" + palette.wallpaper + ":" + palette.wallpaperDim + ":" + w + "x" + h;
+        if (newKey.equals(key)) {
+            return;
+        }
+        key = newKey;
+        final int mine = ++generation;
+        windowWidth = w;
+        windowHeight = h;
+
+        bitmap = render(palette, null, w, h);
+
+        if (palette.wallpaper.length() > 0) {
+            final Context app = context.getApplicationContext();
+            final Uri uri = Uri.parse(palette.wallpaper);
+            new Thread(new Runnable() {
+                @Override
+                public void run() {
+                    final Bitmap still = AeroWallpaper.loadStill(app, uri, LONG_SIDE * 2);
+                    if (still == null) {
+                        return;
+                    }
+                    final Bitmap blurred = render(palette, still, w, h);
+                    MAIN.post(new Runnable() {
+                        @Override
+                        public void run() {
+                            if (mine == generation) {
+                                bitmap = blurred;
+                                if (onChanged != null) {
+                                    onChanged.run();
+                                }
+                            }
+                        }
+                    });
+                }
+            }, "aero-backdrop").start();
+        }
+    }
+
+    private static Bitmap render(AeroPalette palette, Bitmap wallpaper, int w, int h) {
+        float scale = (float) LONG_SIDE / Math.max(w, h);
+        int sw = Math.max(8, Math.round(w * scale));
+        int sh = Math.max(8, Math.round(h * scale));
+        Bitmap out = Bitmap.createBitmap(sw, sh, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(out);
+
+        AeroBackgroundDrawable sky = new AeroBackgroundDrawable(palette);
+        sky.setBounds(0, 0, sw, sh);
+        sky.draw(canvas);
+
+        if (wallpaper != null) {
+            // Centre-crop the wallpaper to the screen's aspect ratio
+            float ww = wallpaper.getWidth();
+            float wh = wallpaper.getHeight();
+            float want = (float) sw / sh;
+            Rect src;
+            if (ww / wh > want) {
+                int cw = Math.round(wh * want);
+                src = new Rect(Math.round((ww - cw) / 2f), 0, Math.round((ww - cw) / 2f) + cw, (int) wh);
+            }
+            else {
+                int ch = Math.round(ww / want);
+                src = new Rect(0, Math.round((wh - ch) / 2f), (int) ww, Math.round((wh - ch) / 2f) + ch);
+            }
+            Paint paint = new Paint(Paint.FILTER_BITMAP_FLAG);
+            canvas.drawBitmap(wallpaper, src, new Rect(0, 0, sw, sh), paint);
+            if (palette.wallpaperDim > 0f) {
+                canvas.drawColor(Color.argb(Math.round(palette.wallpaperDim * 255f), 0, 0, 0));
+            }
+        }
+
+        if (palette.blur > 0f) {
+            int radius = 1 + Math.round(palette.blur * 8f);
+            int[] px = new int[sw * sh];
+            out.getPixels(px, 0, sw, 0, 0, sw, sh);
+            AeroBlur.blur(px, sw, sh, radius);
+            out.setPixels(px, 0, sw, 0, 0, sw, sh);
+        }
+        return out;
+    }
+}
diff --git a/app/src/main/java/com/limelight/aero/AeroBackgroundDrawable.java b/app/src/main/java/com/limelight/aero/AeroBackgroundDrawable.java
new file mode 100644
index 0000000..a9246de
--- /dev/null
+++ b/app/src/main/java/com/limelight/aero/AeroBackgroundDrawable.java
@@ -0,0 +1,147 @@
+package com.limelight.aero;
+
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.RadialGradient;
+import android.graphics.Rect;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+
+/**
+ * Frutiger Aero backdrop: sky gradient, soft sun glow, light rays and two
+ * rolling hills. Port of AeroBackground.qml (the floating bubbles are drawn by
+ * {@link AeroBubbleView} so they can animate without redrawing this).
+ */
+final class AeroBackgroundDrawable extends Drawable {
+    private static final float RAY_ROTATION_DEG = 24f;
+
+    private final AeroPalette palette;
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+    private Shader skyShader;
+    private Shader sunShader;
+    private float sunX;
+    private float sunY;
+    private float sunRadius;
+
+    private final Shader[] rayShaders = new Shader[3];
+    private final float[][] rays = new float[3][];   // left, top, right, bottom
+
+    private Shader hill1Shader;
+    private Shader hill2Shader;
+    private float[] hill1;   // cx, cy, r
+    private float[] hill2;
+
+    AeroBackgroundDrawable(AeroPalette palette) {
+        this.palette = palette;
+    }
+
+    @Override
+    protected void onBoundsChange(Rect bounds) {
+        float w = bounds.width();
+        float h = bounds.height();
+        if (w <= 0 || h <= 0) {
+            return;
+        }
+        float l = bounds.left;
+        float t = bounds.top;
+
+        skyShader = new LinearGradient(0, t, 0, t + h,
+                new int[] {palette.top, palette.mid, palette.bottom},
+                new float[] {0f, 0.55f, 1f}, Shader.TileMode.CLAMP);
+
+        // Sun glow, top-left (six translucent discs in the QML version)
+        float base = Math.max(w, h) * 0.55f;
+        sunX = l + w * 0.18f;
+        sunY = t - h * 0.10f + base * 0.15f;
+        sunRadius = base / 2f;
+        sunShader = new RadialGradient(sunX, sunY, sunRadius,
+                new int[] {0x3dffffff, 0x0bffffff, 0x00ffffff},
+                new float[] {0f, 0.9f, 1f}, Shader.TileMode.CLAMP);
+
+        // Light rays
+        for (int i = 0; i < 3; i++) {
+            float rw = w * (0.10f + i * 0.05f);
+            float rh = h * 1.6f;
+            float rx = l + w * (0.05f + i * 0.17f);
+            float ry = t - h * 0.3f;
+            rays[i] = new float[] {rx, ry, rx + rw, ry + rh};
+            rayShaders[i] = new LinearGradient(0, ry, 0, ry + rh, 0x24ffffff, 0x00ffffff, Shader.TileMode.CLAMP);
+        }
+
+        // Hills: the top arcs of two huge, mostly off-screen circles
+        float r1 = w * 0.75f;
+        float top1 = t + h - h * 0.13f;
+        hill1 = new float[] {l - w * 0.35f + r1, top1 + r1, r1};
+        hill1Shader = new LinearGradient(0, top1, 0, top1 + 2f * r1,
+                new int[] {
+                        AeroColors.withAlpha(AeroColors.lighter(palette.bottom, 1.2f), 0.45f),
+                        AeroColors.withAlpha(palette.bottom, 0.30f),
+                        AeroColors.withAlpha(palette.bottom, 0f)},
+                new float[] {0f, 0.2f, 1f}, Shader.TileMode.CLAMP);
+
+        float r2 = w * 0.65f;
+        float top2 = t + h - h * 0.08f;
+        hill2 = new float[] {l + w * 0.30f + r2, top2 + r2, r2};
+        hill2Shader = new LinearGradient(0, top2, 0, top2 + 2f * r2,
+                new int[] {
+                        AeroColors.withAlpha(AeroColors.darker(palette.bottom, 1.15f), 0.50f),
+                        AeroColors.withAlpha(AeroColors.darker(palette.bottom, 1.3f), 0.30f),
+                        AeroColors.withAlpha(palette.bottom, 0f)},
+                new float[] {0f, 0.2f, 1f}, Shader.TileMode.CLAMP);
+    }
+
+    @Override
+    public void draw(Canvas canvas) {
+        Rect b = getBounds();
+        if (skyShader == null || b.isEmpty()) {
+            return;
+        }
+
+        int save = canvas.save();
+        canvas.clipRect(b);
+
+        paint.setStyle(Paint.Style.FILL);
+
+        paint.setShader(skyShader);
+        canvas.drawRect(b, paint);
+
+        paint.setShader(sunShader);
+        canvas.drawCircle(sunX, sunY, sunRadius, paint);
+
+        for (int i = 0; i < rays.length; i++) {
+            float[] r = rays[i];
+            int rs = canvas.save();
+            canvas.rotate(RAY_ROTATION_DEG, (r[0] + r[2]) / 2f, r[1]);
+            paint.setShader(rayShaders[i]);
+            canvas.drawRect(r[0], r[1], r[2], r[3], paint);
+            canvas.restoreToCount(rs);
+        }
+
+        paint.setShader(hill1Shader);
+        canvas.drawCircle(hill1[0], hill1[1], hill1[2], paint);
+        paint.setShader(hill2Shader);
+        canvas.drawCircle(hill2[0], hill2[1], hill2[2], paint);
+
+        paint.setShader(null);
+        canvas.restoreToCount(save);
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        // Opaque backdrop: constant alpha is not supported.
+    }
+
+    @Override
+    public void setColorFilter(ColorFilter colorFilter) {
+        // Not supported
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.OPAQUE;
+    }
+}
diff --git a/app/src/main/java/com/limelight/aero/AeroBlur.java b/app/src/main/java/com/limelight/aero/AeroBlur.java
new file mode 100644
index 0000000..01beb7d
--- /dev/null
+++ b/app/src/main/java/com/limelight/aero/AeroBlur.java
@@ -0,0 +1,57 @@
+package com.limelight.aero;
+
+/**
+ * Small, dependency-free box blur on ARGB pixel arrays. Three passes of a box
+ * blur approximate a Gaussian closely enough for frosted glass, and it works on
+ * every Android version (RenderEffect needs API 31, RenderScript is deprecated).
+ * It is only ever run on a tiny (~190 px) copy of the background.
+ */
+final class AeroBlur {
+    private AeroBlur() {}
+
+    /** Blurs {@code px} (width * height ARGB pixels) in place. */
+    static void blur(int[] px, int width, int height, int radius) {
+        if (radius < 1 || width < 1 || height < 1 || px.length < width * height) {
+            return;
+        }
+        int[] tmp = new int[width * height];
+        for (int i = 0; i < 3; i++) {
+            pass(px, tmp, width, height, radius, true);
+            pass(tmp, px, width, height, radius, false);
+        }
+    }
+
+    private static int clamp(int v, int max) {
+        return v < 0 ? 0 : (v > max ? max : v);
+    }
+
+    private static void pass(int[] in, int[] out, int w, int h, int r, boolean horizontal) {
+        int len = horizontal ? w : h;
+        int lines = horizontal ? h : w;
+        int step = horizontal ? 1 : w;
+        int win = 2 * r + 1;
+        int last = len - 1;
+        for (int line = 0; line < lines; line++) {
+            int base = horizontal ? line * w : line;
+            int a = 0, rr = 0, g = 0, b = 0;
+            for (int k = -r; k <= r; k++) {
+                int p = in[base + clamp(k, last) * step];
+                a += p >>> 24;
+                rr += (p >> 16) & 0xff;
+                g += (p >> 8) & 0xff;
+                b += p & 0xff;
+            }
+            for (int i = 0; i < len; i++) {
+                int half = win / 2;   // round to nearest, otherwise every pass darkens the picture a little
+                out[base + i * step] = (((a + half) / win) << 24) | (((rr + half) / win) << 16)
+                        | (((g + half) / win) << 8) | ((b + half) / win);
+                int add = in[base + clamp(i + r + 1, last) * step];
+                int rem = in[base + clamp(i - r, last) * step];
+                a += (add >>> 24) - (rem >>> 24);
+                rr += ((add >> 16) & 0xff) - ((rem >> 16) & 0xff);
+                g += ((add >> 8) & 0xff) - ((rem >> 8) & 0xff);
+                b += (add & 0xff) - (rem & 0xff);
+            }
+        }
+    }
+}
diff --git a/app/src/main/java/com/limelight/aero/AeroBubbleView.java b/app/src/main/java/com/limelight/aero/AeroBubbleView.java
new file mode 100644
index 0000000..8315f68
--- /dev/null
+++ b/app/src/main/java/com/limelight/aero/AeroBubbleView.java
@@ -0,0 +1,116 @@
+package com.limelight.aero;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.os.SystemClock;
+import android.provider.Settings;
+import android.view.View;
+
+/**
+ * Slowly rising soap bubbles drawn over the Aero backdrop. Purely decorative:
+ * it never takes input or focus, only animates while the window is visible,
+ * and freezes if the user turned animations off in the system settings.
+ */
+final class AeroBubbleView extends View {
+    private static final int BUBBLE_COUNT = 14;
+
+    private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint rim = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint spark = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF oval = new RectF();
+    private final float dp;
+    private boolean animate = true;
+
+    AeroBubbleView(Context context) {
+        super(context);
+        dp = context.getResources().getDisplayMetrics().density;
+
+        setWillNotDraw(false);
+        setClickable(false);
+        setFocusable(false);
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+
+        fill.setStyle(Paint.Style.FILL);
+        fill.setColor(0x12ffffff);                 // white at 7%
+        rim.setStyle(Paint.Style.STROKE);
+        rim.setStrokeWidth(dp);
+        rim.setColor(0x8cffffff);                  // white at 55%
+        spark.setStyle(Paint.Style.FILL);
+        spark.setColor(0x8cffffff);
+    }
+
+    private boolean shouldRun() {
+        return animate && isShown() && getWindowVisibility() == VISIBLE;
+    }
+
+    private void refreshAnimationScale() {
+        try {
+            animate = Settings.Global.getFloat(getContext().getContentResolver(),
+                    Settings.Global.ANIMATOR_DURATION_SCALE, 1f) > 0f;
+        } catch (RuntimeException e) {
+            animate = true;
+        }
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        refreshAnimationScale();
+        postInvalidateOnAnimation();
+    }
+
+    @Override
+    protected void onWindowVisibilityChanged(int visibility) {
+        super.onWindowVisibilityChanged(visibility);
+        if (visibility == VISIBLE) {
+            refreshAnimationScale();
+            postInvalidateOnAnimation();
+        }
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        int w = getWidth();
+        int h = getHeight();
+        if (w <= 0 || h <= 0) {
+            return;
+        }
+
+        // A frozen clock keeps the bubbles in a pleasant static arrangement
+        long now = animate ? SystemClock.uptimeMillis() : 20000L;
+
+        for (int i = 0; i < BUBBLE_COUNT; i++) {
+            float size = (22 + (i * 37) % 70) * dp;
+            float startX = ((i * 211) % 100) / 100f * w;
+            long riseMs = 14000L + (i * 997L) % 12000L;
+            long delayMs = (i * 733L) % 6000L;
+            long swayMs = 3500L + (i * 313L) % 2500L;
+
+            // Rise from just below the bottom edge to just above the top
+            float progress = ((now + riseMs - delayMs) % riseMs) / (float) riseMs;
+            float y = h + size - progress * (h + 2f * size);
+
+            // Gentle left-right sway of +-28dp
+            double phase = (now % swayMs) / (double) swayMs * 2.0 * Math.PI;
+            float x = startX + (float) Math.sin(phase + i) * 28f * dp;
+
+            float cx = x + size / 2f;
+            float cy = y + size / 2f;
+            canvas.drawCircle(cx, cy, size / 2f, fill);
+            canvas.drawCircle(cx, cy, size / 2f - dp / 2f, rim);
+
+            // Specular highlight
+            int save = canvas.save();
+            canvas.rotate(-30f, x + size * 0.38f, y + size * 0.22f);
+            oval.set(x + size * 0.18f, y + size * 0.12f, x + size * 0.58f, y + size * 0.32f);
+            canvas.drawOval(oval, spark);
+            canvas.restoreToCount(save);
+        }
+
+        if (shouldRun()) {
+            postInvalidateOnAnimation();
+        }
+    }
+}
diff --git a/app/src/main/java/com/limelight/aero/AeroColors.java b/app/src/main/java/com/limelight/aero/AeroColors.java
new file mode 100644
index 0000000..f7cf285
--- /dev/null
+++ b/app/src/main/java/com/limelight/aero/AeroColors.java
@@ -0,0 +1,188 @@
+package com.limelight.aero;
+
+/**
+ * Small colour toolbox for the Frutiger Aero theme.
+ *
+ * Deliberately free of android.* imports so the maths can be unit-tested on a plain JVM.
+ * Colours are packed ARGB ints, exactly like android.graphics.Color.
+ */
+final class AeroColors {
+    private AeroColors() {}
+
+    static int argb(int a, int r, int g, int b) {
+        return (clamp255(a) << 24) | (clamp255(r) << 16) | (clamp255(g) << 8) | clamp255(b);
+    }
+
+    static int alpha(int c) { return (c >>> 24) & 0xff; }
+    static int red(int c)   { return (c >>> 16) & 0xff; }
+    static int green(int c) { return (c >>> 8) & 0xff; }
+    static int blue(int c)  { return c & 0xff; }
+
+    private static int clamp255(int v) {
+        return v < 0 ? 0 : Math.min(v, 255);
+    }
+
+    private static float clamp01(float v) {
+        return v < 0f ? 0f : Math.min(v, 1f);
+    }
+
+    /** Returns the colour with its alpha replaced by {@code a} (0..1). */
+    static int withAlpha(int c, float a) {
+        return (Math.round(clamp01(a) * 255f) << 24) | (c & 0x00ffffff);
+    }
+
+    /** Returns the colour with its alpha multiplied by {@code f} (0..1). */
+    static int scaleAlpha(int c, float f) {
+        return withAlpha(c, (alpha(c) / 255f) * f);
+    }
+
+    static int blend(int from, int to, float t) {
+        t = clamp01(t);
+        return argb(Math.round(alpha(from) + (alpha(to) - alpha(from)) * t),
+                Math.round(red(from) + (red(to) - red(from)) * t),
+                Math.round(green(from) + (green(to) - green(from)) * t),
+                Math.round(blue(from) + (blue(to) - blue(from)) * t));
+    }
+
+    // ------------------------------------------------------------------ HSV
+
+    /** Fills {h (0..1), s, v} for the colour. */
+    private static void toHsv(int c, float[] out) {
+        float r = red(c) / 255f, g = green(c) / 255f, b = blue(c) / 255f;
+        float max = Math.max(r, Math.max(g, b));
+        float min = Math.min(r, Math.min(g, b));
+        float d = max - min;
+        float h;
+        if (d == 0f) {
+            h = 0f;
+        } else if (max == r) {
+            h = ((g - b) / d) % 6f;
+        } else if (max == g) {
+            h = (b - r) / d + 2f;
+        } else {
+            h = (r - g) / d + 4f;
+        }
+        h /= 6f;
+        if (h < 0f) h += 1f;
+        out[0] = h;
+        out[1] = max == 0f ? 0f : d / max;
+        out[2] = max;
+    }
+
+    private static int fromHsv(float h, float s, float v, int a) {
+        h = h - (float) Math.floor(h);
+        float c = v * s;
+        float x = c * (1f - Math.abs((h * 6f) % 2f - 1f));
+        float m = v - c;
+        float r, g, b;
+        int sector = (int) (h * 6f);
+        switch (sector) {
+            case 0:  r = c; g = x; b = 0; break;
+            case 1:  r = x; g = c; b = 0; break;
+            case 2:  r = 0; g = c; b = x; break;
+            case 3:  r = 0; g = x; b = c; break;
+            case 4:  r = x; g = 0; b = c; break;
+            default: r = c; g = 0; b = x; break;
+        }
+        return argb(a, Math.round((r + m) * 255f), Math.round((g + m) * 255f), Math.round((b + m) * 255f));
+    }
+
+    /**
+     * Same behaviour as Qt's Qt.lighter(): scales the HSV value, and lets any
+     * overflow wash out the saturation instead of clipping.
+     */
+    static int lighter(int c, float factor) {
+        float[] hsv = new float[3];
+        toHsv(c, hsv);
+        float v = hsv[2] * factor;
+        float s = hsv[1];
+        if (v > 1f) {
+            s = Math.max(0f, s - (v - 1f));
+            v = 1f;
+        }
+        return fromHsv(hsv[0], s, v, alpha(c));
+    }
+
+    /** Same behaviour as Qt's Qt.darker(): divides the HSV value. */
+    static int darker(int c, float factor) {
+        float[] hsv = new float[3];
+        toHsv(c, hsv);
+        return fromHsv(hsv[0], hsv[1], hsv[2] / factor, alpha(c));
+    }
+
+    // ------------------------------------------------------------------ HSL
+
+    /** Fills {h (0..1), s, l} for the colour. Hue is 0 for greys. */
+    static void toHsl(int c, float[] out) {
+        float r = red(c) / 255f, g = green(c) / 255f, b = blue(c) / 255f;
+        float max = Math.max(r, Math.max(g, b));
+        float min = Math.min(r, Math.min(g, b));
+        float d = max - min;
+        float l = (max + min) / 2f;
+        float h;
+        float s;
+        if (d == 0f) {
+            h = 0f;
+            s = 0f;
+        } else {
+            s = d / (1f - Math.abs(2f * l - 1f));
+            if (max == r) {
+                h = ((g - b) / d) % 6f;
+            } else if (max == g) {
+                h = (b - r) / d + 2f;
+            } else {
+                h = (r - g) / d + 4f;
+            }
+            h /= 6f;
+            if (h < 0f) h += 1f;
+        }
+        out[0] = h;
+        out[1] = s;
+        out[2] = l;
+    }
+
+    static int fromHsl(float h, float s, float l) {
+        h = h - (float) Math.floor(h);
+        s = clamp01(s);
+        l = clamp01(l);
+        float c = (1f - Math.abs(2f * l - 1f)) * s;
+        float x = c * (1f - Math.abs((h * 6f) % 2f - 1f));
+        float m = l - c / 2f;
+        float r, g, b;
+        int sector = (int) (h * 6f);
+        switch (sector) {
+            case 0:  r = c; g = x; b = 0; break;
+            case 1:  r = x; g = c; b = 0; break;
+            case 2:  r = 0; g = c; b = x; break;
+            case 3:  r = 0; g = x; b = c; break;
+            case 4:  r = x; g = 0; b = c; break;
+            default: r = c; g = 0; b = x; break;
+        }
+        return argb(255, Math.round((r + m) * 255f), Math.round((g + m) * 255f), Math.round((b + m) * 255f));
+    }
+
+    // ------------------------------------------------------------------ Parsing
+
+    /** True for strictly "#rrggbb". */
+    static boolean isHex(String s) {
+        if (s == null || s.length() != 7 || s.charAt(0) != '#') {
+            return false;
+        }
+        for (int i = 1; i < 7; i++) {
+            char ch = s.charAt(i);
+            boolean ok = (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F');
+            if (!ok) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** Parses "#rrggbb" into an opaque colour, or returns {@code fallback} when it is not valid. */
+    static int parseHex(String s, int fallback) {
+        if (!isHex(s)) {
+            return fallback;
+        }
+        return 0xff000000 | Integer.parseInt(s.substring(1), 16);
+    }
+}
diff --git a/app/src/main/java/com/limelight/aero/AeroGlassDrawable.java b/app/src/main/java/com/limelight/aero/AeroGlassDrawable.java
new file mode 100644
index 0000000..e13f526
--- /dev/null
+++ b/app/src/main/java/com/limelight/aero/AeroGlassDrawable.java
@@ -0,0 +1,307 @@
+package com.limelight.aero;
+
+import android.animation.ValueAnimator;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+import android.view.View;
+import android.view.animation.OvershootInterpolator;
+
+/**
+ * A "liquid glass" Frutiger Aero surface.
+ *
+ *  - frosted: shows the blurred background (sky or wallpaper) that lies behind the view,
+ *    clipped to a generously rounded shape
+ *  - a light tint, a soft sheen that fades to nothing (no hard gloss band) and an inner glow
+ *  - a specular rim, brightest at the top-left and bottom-right and faint along the sides
+ *  - diffuse shadow and a soft glow instead of a hard focus ring
+ *  - springy motion: it grows when hovered or selected and squashes when pressed, overshooting a
+ *    little before settling, driven by the view state (so it works with touch, TV remote and mouse)
+ *
+ * Everything is drawn inside the drawable's bounds (shadow, glow and the spring's overshoot live in
+ * the {@code inset} margin) so it survives parents that clip their children.
+ */
+final class AeroGlassDrawable extends Drawable {
+    private static final float REST = 1f;
+    private static final float HOVER = 1.035f;
+    private static final float PRESS = 0.955f;
+
+    private final int tint;
+    private final float density;     // 0..1, how opaque the glass is
+    private final boolean blur;      // show the blurred backdrop
+    private final float dp;          // pixels per dp
+    private final float radiusDp;    // corner radius; ignored for orbs
+    private final float insetDp;     // margin kept free around the body
+    private final boolean orb;
+    private final boolean shadow;
+    private final boolean springy;
+
+    private boolean hovered;
+    private boolean pressed;
+    private boolean focused;
+    private float spring = REST;
+    private float glowAmount = 0f;   // 0..1, hover / focus glow
+    private ValueAnimator animator;
+
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint bitmapPaint = new Paint(Paint.FILTER_BITMAP_FLAG | Paint.ANTI_ALIAS_FLAG);
+    private final RectF body = new RectF();
+    private final RectF tmp = new RectF();
+    private final Rect srcRect = new Rect();
+    private final Path clip = new Path();
+    private final int[] location = new int[2];
+
+    private Shader tintShader;
+    private Shader sheenShader;
+    private Shader rimShader;
+    private float radius;
+
+    AeroGlassDrawable(int tint, float density, boolean blur, float dp, float radiusDp, float insetDp,
+                      boolean orb, boolean shadow, boolean springy) {
+        this.tint = tint;
+        this.density = density;
+        this.blur = blur;
+        this.dp = dp;
+        this.radiusDp = radiusDp;
+        this.insetDp = insetDp;
+        this.orb = orb;
+        this.shadow = shadow;
+        this.springy = springy;
+    }
+
+    /** Opacity of the tint layer. Less is needed when the blurred backdrop already frosts the glass. */
+    private float strength() {
+        return blur ? 0.10f + 0.40f * density : 0.22f + 0.55f * density;
+    }
+
+    // ------------------------------------------------------------------ state / spring
+
+    @Override
+    public boolean isStateful() {
+        return true;
+    }
+
+    @Override
+    protected boolean onStateChange(int[] state) {
+        boolean newPressed = false;
+        boolean newHovered = false;
+        boolean newFocused = false;
+        for (int s : state) {
+            if (s == android.R.attr.state_pressed) {
+                newPressed = true;
+            }
+            else if (s == android.R.attr.state_hovered) {
+                newHovered = true;
+            }
+            else if (s == android.R.attr.state_selected || s == android.R.attr.state_focused) {
+                newFocused = true;
+            }
+        }
+        if (newPressed == pressed && newHovered == hovered && newFocused == focused) {
+            return false;
+        }
+        pressed = newPressed;
+        hovered = newHovered;
+        focused = newFocused;
+
+        final float targetSpring = !springy ? REST : (pressed ? PRESS : ((hovered || focused) ? HOVER : REST));
+        final float targetGlow = (focused || pressed) ? 1f : (hovered ? 0.55f : 0f);
+        final float fromSpring = spring;
+        final float fromGlow = glowAmount;
+        if (animator != null) {
+            animator.cancel();
+        }
+        animator = ValueAnimator.ofFloat(0f, 1f);
+        // Pressing is quick and tight; letting go is slow and bouncy (that is the "liquid" feel)
+        animator.setDuration(pressed ? 110 : 520);
+        animator.setInterpolator(pressed ? new android.view.animation.DecelerateInterpolator()
+                                         : new OvershootInterpolator(2.2f));
+        animator.addUpdateListener(new ValueAnimator.AnimatorUpdateListener() {
+            @Override
+            public void onAnimationUpdate(ValueAnimator a) {
+                float t = (Float) a.getAnimatedValue();
+                spring = fromSpring + (targetSpring - fromSpring) * t;
+                glowAmount = Math.max(0f, Math.min(1f, fromGlow + (targetGlow - fromGlow) * Math.min(1f, t)));
+                invalidateSelf();
+            }
+        });
+        animator.start();
+        invalidateSelf();
+        return true;
+    }
+
+    // ------------------------------------------------------------------ geometry
+
+    @Override
+    protected void onBoundsChange(Rect bounds) {
+        float inset = insetDp * dp;
+        body.set(bounds.left + inset, bounds.top + inset, bounds.right - inset, bounds.bottom - inset);
+        if (body.width() <= 0 || body.height() <= 0) {
+            body.setEmpty();
+            return;
+        }
+        radius = orb ? Math.min(body.width(), body.height()) / 2f
+                     : Math.min(radiusDp * dp, Math.min(body.width(), body.height()) / 2f);
+
+        float a = strength();
+        tintShader = new LinearGradient(0, body.top, 0, body.bottom,
+                new int[] {
+                        AeroColors.withAlpha(AeroColors.lighter(tint, 1.25f), a),
+                        AeroColors.withAlpha(tint, a * 0.85f),
+                        AeroColors.withAlpha(AeroColors.darker(tint, 1.35f), Math.min(1f, a * 1.05f + 0.04f)),
+                },
+                new float[] {0f, 0.55f, 1f}, Shader.TileMode.CLAMP);
+
+        // Sheen: fades smoothly to nothing, so there is no visible band edge
+        sheenShader = new LinearGradient(0, body.top, 0, body.bottom,
+                new int[] {0x33ffffff, 0x00ffffff, 0x00ffffff,
+                           AeroColors.withAlpha(AeroColors.lighter(tint, 1.6f), 0.14f)},
+                new float[] {0f, 0.45f, 0.85f, 1f}, Shader.TileMode.CLAMP);
+
+        // Specular rim: bright top-left and bottom-right, faint in between
+        rimShader = new LinearGradient(body.left, body.top, body.right, body.bottom,
+                new int[] {0xffffffff, 0xccffffff, 0x2effffff, 0xb3ffffff, 0xf2ffffff},
+                new float[] {0f, 0.18f, 0.5f, 0.82f, 1f}, Shader.TileMode.CLAMP);
+    }
+
+    // ------------------------------------------------------------------ drawing
+
+    @Override
+    public void draw(Canvas canvas) {
+        if (body.isEmpty() || tintShader == null) {
+            return;
+        }
+        int save = canvas.save();
+        canvas.scale(spring, spring, body.centerX(), body.centerY());
+
+        // Soft diffuse shadow: stacked translucent shapes that fade outwards
+        if (shadow) {
+            paint.setShader(null);
+            paint.setStyle(Paint.Style.FILL);
+            paint.setColor(0x13001018);
+            for (int i = 4; i >= 0; i--) {
+                float grow = (i * 1.6f + 0.5f) * dp;
+                tmp.set(body.left - grow, body.top - grow + 2.2f * dp, body.right + grow, body.bottom + grow + 2.2f * dp);
+                canvas.drawRoundRect(tmp, radius + grow, radius + grow, paint);
+            }
+        }
+
+        // Glow around the glass when hovered or selected
+        if (glowAmount > 0.01f) {
+            paint.setShader(null);
+            paint.setStyle(Paint.Style.FILL);
+            for (int i = 3; i >= 0; i--) {
+                float grow = (1.5f + i * 1.4f) * dp;
+                paint.setColor(AeroColors.withAlpha(AeroColors.lighter(tint, 1.6f), (0.12f - i * 0.025f) * glowAmount));
+                tmp.set(body.left - grow, body.top - grow, body.right + grow, body.bottom + grow);
+                canvas.drawRoundRect(tmp, radius + grow, radius + grow, paint);
+            }
+        }
+
+        drawBackdrop(canvas);
+
+        // Tint
+        paint.setStyle(Paint.Style.FILL);
+        paint.setShader(tintShader);
+        canvas.drawRoundRect(body, radius, radius, paint);
+
+        // Sheen
+        paint.setShader(sheenShader);
+        paint.setAlpha(Math.round(255f * (0.5f + 0.5f * density)));
+        canvas.drawRoundRect(body, radius, radius, paint);
+        paint.setAlpha(255);
+        paint.setShader(null);
+
+        // Inner glow: nested hairlines that fade towards the centre
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(1.5f * dp);
+        for (int i = 0; i < 3; i++) {
+            float off = (1f + i * 1.5f) * dp;
+            tmp.set(body.left + off, body.top + off, body.right - off, body.bottom - off);
+            if (tmp.width() <= 0 || tmp.height() <= 0) {
+                break;
+            }
+            paint.setColor(AeroColors.withAlpha(0xffffffff, 0.11f - i * 0.035f));
+            float r = Math.max(0f, radius - off);
+            canvas.drawRoundRect(tmp, r, r, paint);
+        }
+
+        // Pressed: dim softly
+        if (pressed) {
+            paint.setStyle(Paint.Style.FILL);
+            paint.setColor(0x33000a14);
+            canvas.drawRoundRect(body, radius, radius, paint);
+        }
+
+        // Specular rim
+        float rimWidth = (focused ? 2f : 1.5f) * dp;
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(rimWidth);
+        paint.setShader(rimShader);
+        paint.setAlpha(Math.round(255f * (focused ? 1f : (0.72f + 0.2f * glowAmount))));
+        tmp.set(body);
+        tmp.inset(rimWidth / 2f, rimWidth / 2f);
+        float rr = Math.max(0f, radius - rimWidth / 2f);
+        canvas.drawRoundRect(tmp, rr, rr, paint);
+        paint.setAlpha(255);
+        paint.setShader(null);
+        paint.setStyle(Paint.Style.FILL);
+
+        canvas.restoreToCount(save);
+    }
+
+    /** Draws the part of the blurred background that sits behind this view, clipped to the glass shape. */
+    private void drawBackdrop(Canvas canvas) {
+        Bitmap backdrop = blur ? AeroBackdrop.bitmap() : null;
+        if (backdrop == null) {
+            return;
+        }
+        Callback callback = getCallback();
+        if (!(callback instanceof View)) {
+            return;
+        }
+        View view = (View) callback;
+        view.getLocationInWindow(location);
+        float wx = AeroBackdrop.windowWidth();
+        float wy = AeroBackdrop.windowHeight();
+        float sx = backdrop.getWidth() / wx;
+        float sy = backdrop.getHeight() / wy;
+        // Account for the spring scale: the view is drawn scaled around the centre of the body
+        float left = location[0] + (body.left - getBounds().left);
+        float top = location[1] + (body.top - getBounds().top);
+        srcRect.set(Math.round(left * sx), Math.round(top * sy),
+                Math.round((left + body.width()) * sx), Math.round((top + body.height()) * sy));
+        if (srcRect.width() < 1 || srcRect.height() < 1) {
+            return;
+        }
+        int save = canvas.save();
+        clip.reset();
+        clip.addRoundRect(body, radius, radius, Path.Direction.CW);
+        canvas.clipPath(clip);
+        canvas.drawBitmap(backdrop, srcRect, body, bitmapPaint);
+        canvas.restoreToCount(save);
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        // The glass is already translucent by design; a constant alpha is not supported.
+    }
+
+    @Override
+    public void setColorFilter(ColorFilter colorFilter) {
+        // Not supported
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.TRANSLUCENT;
+    }
+}
diff --git a/app/src/main/java/com/limelight/aero/AeroPalette.java b/app/src/main/java/com/limelight/aero/AeroPalette.java
new file mode 100644
index 0000000..8f7b2c8
--- /dev/null
+++ b/app/src/main/java/com/limelight/aero/AeroPalette.java
@@ -0,0 +1,160 @@
+package com.limelight.aero;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.preference.PreferenceManager;
+
+/**
+ * Immutable snapshot of the Frutiger Aero settings, plus the four colours
+ * (sky top, sky middle, horizon, accent) derived from them.
+ *
+ * The preset names and colours mirror the desktop (Qt) version of the theme.
+ */
+public final class AeroPalette {
+    public static final String PREF_ENABLED = "checkbox_aero_enabled";
+    public static final String PREF_PRESET = "list_aero_preset";
+    public static final String PREF_COLOR = "edit_aero_color";
+    public static final String PREF_GLASS = "seekbar_aero_glass";
+    public static final String PREF_BUBBLES = "checkbox_aero_bubbles";
+    public static final String PREF_BLUR = "seekbar_aero_blur";
+    public static final String PREF_WALLPAPER = "edit_aero_wallpaper";
+    public static final String PREF_WALLPAPER_DIM = "seekbar_aero_wallpaper_dim";
+
+    public static final String PRESET_CUSTOM = "custom";
+
+    public static final boolean DEFAULT_ENABLED = true;
+    public static final String DEFAULT_PRESET = "aqua";
+    public static final String DEFAULT_COLOR = "#1c9bdc";
+    public static final int DEFAULT_GLASS = 55;
+    public static final boolean DEFAULT_BUBBLES = true;
+    public static final int DEFAULT_BLUR = 60;
+    public static final int DEFAULT_WALLPAPER_DIM = 25;
+    public static final int WALLPAPER_DIM_MAX = 80;
+
+    public static final int GLASS_MIN = 10;
+    public static final int GLASS_MAX = 90;
+
+    private static final int[][] PRESETS = {
+            // top, mid, bottom, accent
+            {0xff073b88, 0xff1c9bdc, 0xff4fd8c6, 0xff38c9f6}, // aqua
+            {0xff12559e, 0xff3fa9e6, 0xff46b85a, 0xff7edc54}, // bliss
+            {0xff1b2f7a, 0xffd6568f, 0xfff08a3c, 0xffffb04a}, // sunset
+            {0xff06173a, 0xff0c6a86, 0xff1fd0a0, 0xff4af0c8}, // aurora
+    };
+    private static final String[] PRESET_KEYS = {"aqua", "bliss", "sunset", "aurora"};
+
+    public final boolean enabled;
+    public final boolean bubbles;
+    /** Glass opacity, 0.1 (very clear) to 0.9 (nearly opaque). */
+    public final float glass;
+    /** Backdrop blur behind the glass, 0 (plain translucent glass) to 1. */
+    public final float blur;
+    /** Content URI of the wallpaper (image, GIF or video), or "" for the sky. */
+    public final String wallpaper;
+    /** How much the wallpaper is darkened, 0 to 0.8. */
+    public final float wallpaperDim;
+    public final int top;
+    public final int mid;
+    public final int bottom;
+    public final int accent;
+
+    private AeroPalette(boolean enabled, boolean bubbles, float glass, int[] scheme,
+                        float blur, String wallpaper, float wallpaperDim) {
+        this.blur = blur;
+        this.wallpaper = enabled && wallpaper != null ? wallpaper : "";
+        this.wallpaperDim = wallpaperDim;
+        this.enabled = enabled;
+        this.bubbles = enabled && bubbles;
+        this.glass = glass;
+        this.top = scheme[0];
+        this.mid = scheme[1];
+        this.bottom = scheme[2];
+        this.accent = scheme[3];
+    }
+
+    /** Pure factory (no Android dependencies); invalid input falls back to the defaults. */
+    public static AeroPalette fromValues(boolean enabled, String preset, String hex, int glassPercent, boolean bubbles) {
+        return fromValues(enabled, preset, hex, glassPercent, bubbles, DEFAULT_BLUR, "", DEFAULT_WALLPAPER_DIM);
+    }
+
+    public static AeroPalette fromValues(boolean enabled, String preset, String hex, int glassPercent, boolean bubbles,
+                                         int blurPercent, String wallpaper, int dimPercent) {
+        int clamped = Math.max(GLASS_MIN, Math.min(GLASS_MAX, glassPercent));
+        return new AeroPalette(enabled, bubbles, clamped / 100f, schemeFor(preset, hex),
+                Math.max(0, Math.min(100, blurPercent)) / 100f, wallpaper,
+                Math.max(0, Math.min(WALLPAPER_DIM_MAX, dimPercent)) / 100f);
+    }
+
+    public static AeroPalette read(Context context) {
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+        return fromValues(
+                prefs.getBoolean(PREF_ENABLED, DEFAULT_ENABLED),
+                prefs.getString(PREF_PRESET, DEFAULT_PRESET),
+                prefs.getString(PREF_COLOR, DEFAULT_COLOR),
+                prefs.getInt(PREF_GLASS, DEFAULT_GLASS),
+                prefs.getBoolean(PREF_BUBBLES, DEFAULT_BUBBLES),
+                prefs.getInt(PREF_BLUR, DEFAULT_BLUR),
+                prefs.getString(PREF_WALLPAPER, ""),
+                prefs.getInt(PREF_WALLPAPER_DIM, DEFAULT_WALLPAPER_DIM));
+    }
+
+    /** True for exactly "#rrggbb" (either case). */
+    public static boolean isValidColor(String value) {
+        return AeroColors.isHex(value);
+    }
+
+    /** True if the given SharedPreferences key belongs to the Aero theme. */
+    public static boolean isAeroPreference(String key) {
+        return PREF_ENABLED.equals(key) || PREF_PRESET.equals(key) || PREF_COLOR.equals(key)
+                || PREF_GLASS.equals(key) || PREF_BUBBLES.equals(key)
+                || PREF_BLUR.equals(key) || PREF_WALLPAPER.equals(key) || PREF_WALLPAPER_DIM.equals(key);
+    }
+
+    public static boolean isEnabled(Context context) {
+        return PreferenceManager.getDefaultSharedPreferences(context)
+                .getBoolean(PREF_ENABLED, DEFAULT_ENABLED);
+    }
+
+    private static int[] schemeFor(String preset, String hex) {
+        for (int i = 0; i < PRESET_KEYS.length; i++) {
+            if (PRESET_KEYS[i].equals(preset)) {
+                return PRESETS[i];
+            }
+        }
+        if (PRESET_CUSTOM.equals(preset)) {
+            return customScheme(AeroColors.parseHex(hex, PRESETS[0][1]));
+        }
+        return PRESETS[0];
+    }
+
+    /** Builds a whole scheme out of the single colour chosen for the Custom preset. */
+    static int[] customScheme(int base) {
+        float[] hsl = new float[3];
+        AeroColors.toHsl(base, hsl);
+        float h = hsl[0];
+        // Keep greys grey (graphite / silver look); otherwise make sure the scheme is colourful enough
+        float s = hsl[1] < 0.1f ? hsl[1] : Math.max(0.45f, hsl[1]);
+        return new int[] {
+                AeroColors.fromHsl(h, s, 0.20f),
+                AeroColors.fromHsl(h, s, 0.46f),
+                AeroColors.fromHsl((h + 0.12f) % 1f, s, 0.52f),
+                AeroColors.fromHsl(h, Math.min(1f, s + 0.1f), 0.62f),
+        };
+    }
+
+    /** Cheap identity used to skip re-styling views that already have this exact look. */
+    public int signature() {
+        int result = 17;
+        result = 31 * result + (enabled ? 1 : 0);
+        result = 31 * result + (bubbles ? 1 : 0);
+        result = 31 * result + Float.floatToIntBits(glass);
+        result = 31 * result + top;
+        result = 31 * result + mid;
+        result = 31 * result + bottom;
+        result = 31 * result + accent;
+        result = 31 * result + Float.floatToIntBits(blur);
+        result = 31 * result + wallpaper.hashCode();
+        result = 31 * result + Float.floatToIntBits(wallpaperDim);
+        return result;
+    }
+}
diff --git a/app/src/main/java/com/limelight/aero/AeroTheme.java b/app/src/main/java/com/limelight/aero/AeroTheme.java
new file mode 100644
index 0000000..d563b46
--- /dev/null
+++ b/app/src/main/java/com/limelight/aero/AeroTheme.java
@@ -0,0 +1,320 @@
+package com.limelight.aero;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.res.TypedArray;
+import android.graphics.Color;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.Drawable;
+import android.net.Uri;
+import android.util.TypedValue;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.widget.AbsListView;
+import android.widget.FrameLayout;
+import android.widget.ImageButton;
+
+import com.limelight.R;
+
+/**
+ * Entry points of the Frutiger Aero theme. Every call is idempotent and cheap,
+ * and when the theme is switched off the original look is restored.
+ *
+ * The theme only touches the menu screens (PC list, app list, settings, add-PC);
+ * the streaming activity never calls into this class.
+ */
+public final class AeroTheme {
+    private AeroTheme() {}
+
+    // Layout constants, in dp
+    private static final float PC_TILE_RADIUS = 26f;
+    private static final float APP_TILE_RADIUS = 20f;
+    private static final float TILE_INSET = 7f;       // room for the shadow, glow and spring overshoot
+    private static final float ORB_INSET = 6f;
+    private static final float ORB_ICON_PADDING = 13f;
+    private static final float PANE_RADIUS = 24f;
+
+    private static final int[] ORB_BUTTON_IDS = {
+            R.id.settingsButton, R.id.helpButton, R.id.manuallyAddPc
+    };
+
+    // ------------------------------------------------------------------ Activity
+
+    /**
+     * Paints the sky backdrop, adds the floating bubbles and turns the toolbar
+     * buttons into glass orbs. Safe to call repeatedly (e.g. from onResume).
+     *
+     * @return true if the look changed since the last call (theme toggled or re-coloured),
+     *         so callers can refresh their grids
+     */
+    public static boolean apply(Activity activity) {
+        AeroPalette palette = AeroPalette.read(activity);
+        Window window = activity.getWindow();
+        View decor = window.getDecorView();
+        ViewGroup content = (ViewGroup) activity.findViewById(android.R.id.content);
+        float dp = activity.getResources().getDisplayMetrics().density;
+
+        Object previous = decor.getTag(R.id.aero_style_signature);
+
+        if (!palette.enabled) {
+            if (previous != null) {
+                // Theme was on: put everything back the way the stock app has it
+                Drawable original = decor.getTag(R.id.aero_original_background) instanceof Drawable
+                        ? (Drawable) decor.getTag(R.id.aero_original_background)
+                        : resolveWindowBackground(activity);
+                window.setBackgroundDrawable(original);
+                decor.setTag(R.id.aero_style_signature, null);
+                decor.setTag(R.id.aero_original_background, null);
+                setBubbles(activity, content, false);
+                setWallpaper(activity, content, null);
+                for (int id : ORB_BUTTON_IDS) {
+                    unstyleOrb(activity.findViewById(id));
+                }
+            }
+            return previous != null;
+        }
+
+        int signature = palette.signature();
+        if (previous == null) {
+            // First time: remember the stock window background so it can be restored later
+            decor.setTag(R.id.aero_original_background, resolveWindowBackground(activity));
+        }
+        boolean changed = previous == null || (Integer) previous != signature;
+        if (changed) {
+            window.setBackgroundDrawable(new AeroBackgroundDrawable(palette));
+            decor.setTag(R.id.aero_style_signature, signature);
+        }
+
+        setWallpaper(activity, content, palette);
+        setBubbles(activity, content, palette.bubbles);
+        AeroBackdrop.ensure(activity, palette, new Runnable() {
+            @Override
+            public void run() {
+                redrawGlass(decor);
+            }
+        });
+
+        for (int id : ORB_BUTTON_IDS) {
+            View v = activity.findViewById(id);
+            if (v != null) {
+                styleOrb(v, palette, dp, signature);
+            }
+        }
+        return changed;
+    }
+
+    private static Drawable resolveWindowBackground(Context context) {
+        TypedValue tv = new TypedValue();
+        if (context.getTheme().resolveAttribute(android.R.attr.windowBackground, tv, true)) {
+            if (tv.resourceId != 0) {
+                return context.getDrawable(tv.resourceId);
+            }
+            if (tv.type >= TypedValue.TYPE_FIRST_COLOR_INT && tv.type <= TypedValue.TYPE_LAST_COLOR_INT) {
+                return new ColorDrawable(tv.data);
+            }
+        }
+        return new ColorDrawable(0xff303030);
+    }
+
+    /** Adds, updates or removes the wallpaper layer (image / GIF / video). It sits behind the bubbles. */
+    private static void setWallpaper(Activity activity, ViewGroup content, AeroPalette palette) {
+        if (content == null) {
+            return;
+        }
+        View existing = content.findViewById(R.id.aero_wallpaper_view);
+        boolean wanted = palette != null && palette.wallpaper.length() > 0;
+        if (!wanted) {
+            if (existing != null) {
+                content.removeView(existing);
+            }
+            return;
+        }
+        AeroWallpaperView view;
+        if (existing instanceof AeroWallpaperView) {
+            view = (AeroWallpaperView) existing;
+        }
+        else {
+            view = new AeroWallpaperView(activity);
+            view.setId(R.id.aero_wallpaper_view);
+            content.addView(view, 0, new FrameLayout.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        }
+        view.setSource(Uri.parse(palette.wallpaper), palette.wallpaperDim);
+    }
+
+    /** Glass views cache their drawing, so ask the themed ones to repaint (the blurred backdrop changed). */
+    private static void redrawGlass(View view) {
+        if (view.getTag(R.id.aero_style_signature) != null) {
+            view.invalidate();
+        }
+        if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) {
+                redrawGlass(group.getChildAt(i));
+            }
+        }
+    }
+
+    private static void setBubbles(Activity activity, ViewGroup content, boolean wanted) {
+        if (content == null) {
+            return;
+        }
+        View existing = content.findViewById(R.id.aero_bubble_view);
+        if (wanted && existing == null) {
+            AeroBubbleView bubbles = new AeroBubbleView(activity);
+            bubbles.setId(R.id.aero_bubble_view);
+            // Behind the real UI, in front of the window background
+            content.addView(bubbles, 0, new FrameLayout.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        }
+        else if (!wanted && existing != null) {
+            content.removeView(existing);
+        }
+    }
+
+    // ------------------------------------------------------------------ Glass orbs (toolbar buttons)
+
+    private static void styleOrb(View button, AeroPalette palette, float dp, int signature) {
+        Object tagged = button.getTag(R.id.aero_style_signature);
+        if (tagged != null && (Integer) tagged == signature) {
+            return;
+        }
+        if (button.getTag(R.id.aero_original_background) == null) {
+            // Remember the stock look the first time we touch this button
+            button.setTag(R.id.aero_original_background, button.getBackground());
+            button.setTag(R.id.aero_original_padding, new int[] {
+                    button.getPaddingLeft(), button.getPaddingTop(),
+                    button.getPaddingRight(), button.getPaddingBottom()});
+        }
+        button.setBackground(glass(palette.accent, palette, dp, 0f, ORB_INSET, true, true, true));
+        int pad = Math.round(ORB_ICON_PADDING * dp);
+        button.setPadding(pad, pad, pad, pad);
+        button.setTag(R.id.aero_style_signature, signature);
+    }
+
+    private static void unstyleOrb(View button) {
+        if (button == null || button.getTag(R.id.aero_style_signature) == null) {
+            return;
+        }
+        Object background = button.getTag(R.id.aero_original_background);
+        if (background instanceof Drawable) {
+            button.setBackground(((Drawable) background).getConstantState() != null
+                    ? ((Drawable) background).getConstantState().newDrawable()
+                    : (Drawable) background);
+        }
+        Object padding = button.getTag(R.id.aero_original_padding);
+        if (padding instanceof int[]) {
+            int[] p = (int[]) padding;
+            button.setPadding(p[0], p[1], p[2], p[3]);
+        }
+        button.setTag(R.id.aero_style_signature, null);
+        button.setTag(R.id.aero_original_background, null);
+        button.setTag(R.id.aero_original_padding, null);
+    }
+
+    // ------------------------------------------------------------------ Grid tiles
+
+    /**
+     * Gives a PC / app grid tile a glass background (or removes it when the
+     * theme is off). Called from {@code GenericGridAdapter.getView()}.
+     */
+    public static void styleTile(View tile, ViewGroup parent, boolean largeTile) {
+        Context context = tile.getContext();
+        AeroPalette palette = AeroPalette.read(context);
+        Object tagged = tile.getTag(R.id.aero_style_signature);
+
+        if (parent instanceof AbsListView) {
+            styleGridSelector((AbsListView) parent, palette.enabled);
+        }
+
+        if (!palette.enabled) {
+            if (tagged != null) {
+                tile.setBackground(null);
+                tile.setTag(R.id.aero_style_signature, null);
+            }
+            return;
+        }
+
+        int signature = palette.signature() * 31 + (largeTile ? 1 : 0);
+        if (tagged != null && (Integer) tagged == signature) {
+            return;
+        }
+        float dp = context.getResources().getDisplayMetrics().density;
+        tile.setBackground(glass(palette.accent, palette, dp,
+                largeTile ? PC_TILE_RADIUS : APP_TILE_RADIUS, TILE_INSET, false, true, true));
+        tile.setTag(R.id.aero_style_signature, signature);
+    }
+
+    /** The stock list selector would paint a grey square under our glass, so hide it while themed. */
+    private static void styleGridSelector(AbsListView grid, boolean themed) {
+        Object original = grid.getTag(R.id.aero_original_selector);
+        if (themed) {
+            if (original == null) {
+                grid.setTag(R.id.aero_original_selector, grid.getSelector());
+                grid.setSelector(new ColorDrawable(Color.TRANSPARENT));
+                // The frosted backdrop depends on where a tile is on screen, so repaint tiles while scrolling
+                grid.setOnScrollListener(new AbsListView.OnScrollListener() {
+                    @Override
+                    public void onScrollStateChanged(AbsListView view, int scrollState) {
+                    }
+
+                    @Override
+                    public void onScroll(AbsListView view, int first, int visible, int total) {
+                        for (int i = 0; i < view.getChildCount(); i++) {
+                            view.getChildAt(i).invalidate();
+                        }
+                    }
+                });
+            }
+        }
+        else if (original instanceof Drawable) {
+            grid.setSelector((Drawable) original);
+            grid.setOnScrollListener(null);
+            grid.setTag(R.id.aero_original_selector, null);
+        }
+    }
+
+    // ------------------------------------------------------------------ Settings pane
+
+    /** Wraps the settings list in a pane of dark glass (or removes it when the theme is off). */
+    public static void stylePane(View pane) {
+        if (pane == null) {
+            return;
+        }
+        Context context = pane.getContext();
+        AeroPalette palette = AeroPalette.read(context);
+        Object tagged = pane.getTag(R.id.aero_style_signature);
+
+        if (!palette.enabled) {
+            if (tagged != null) {
+                Object original = pane.getTag(R.id.aero_original_background);
+                pane.setBackground(original instanceof Drawable ? (Drawable) original : null);
+                pane.setTag(R.id.aero_style_signature, null);
+                pane.setTag(R.id.aero_original_background, null);
+            }
+            return;
+        }
+
+        int signature = palette.signature();
+        if (tagged != null && (Integer) tagged == signature) {
+            return;
+        }
+        if (tagged == null) {
+            pane.setTag(R.id.aero_original_background, pane.getBackground());
+        }
+        float dp = context.getResources().getDisplayMetrics().density;
+        pane.setBackground(new AeroGlassDrawable(AeroColors.darker(palette.mid, 1.35f),
+                Math.max(0.6f, palette.glass), palette.blur > 0f, dp, PANE_RADIUS, 6f, false, false, false));
+        pane.setTag(R.id.aero_style_signature, signature);
+    }
+
+    // ------------------------------------------------------------------ Helpers
+
+    /** Builds one glass background; it follows the view state (pressed / selected / focused / hovered) itself. */
+    private static Drawable glass(int tint, AeroPalette palette, float dp, float radiusDp,
+                                  float insetDp, boolean orb, boolean shadow, boolean springy) {
+        return new AeroGlassDrawable(tint, palette.glass, palette.blur > 0f, dp, radiusDp, insetDp,
+                orb, shadow, springy);
+    }
+}
diff --git a/app/src/main/java/com/limelight/aero/AeroWallpaper.java b/app/src/main/java/com/limelight/aero/AeroWallpaper.java
new file mode 100644
index 0000000..a54a54c
--- /dev/null
+++ b/app/src/main/java/com/limelight/aero/AeroWallpaper.java
@@ -0,0 +1,82 @@
+package com.limelight.aero;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.media.MediaMetadataRetriever;
+import android.net.Uri;
+
+import java.io.InputStream;
+import java.util.Locale;
+
+/** Helpers to classify and decode the user's wallpaper file. All of it may be slow: call off the UI thread. */
+final class AeroWallpaper {
+    private AeroWallpaper() {}
+
+    static boolean isVideo(Context context, Uri uri) {
+        String type = null;
+        try {
+            type = context.getContentResolver().getType(uri);
+        }
+        catch (Exception ignored) {
+        }
+        if (type != null) {
+            return type.startsWith("video/");
+        }
+        String path = String.valueOf(uri).toLowerCase(Locale.ROOT);
+        return path.endsWith(".mp4") || path.endsWith(".webm") || path.endsWith(".mkv")
+                || path.endsWith(".mov") || path.endsWith(".3gp");
+    }
+
+    /**
+     * A single frame, decoded at roughly {@code targetSide} pixels on its long side (or a bit more).
+     * Returns null if the file cannot be read. GIFs yield their first frame.
+     */
+    static Bitmap loadStill(Context context, Uri uri, int targetSide) {
+        try {
+            if (isVideo(context, uri)) {
+                MediaMetadataRetriever retriever = new MediaMetadataRetriever();
+                try {
+                    retriever.setDataSource(context, uri);
+                    return retriever.getFrameAtTime(0);
+                }
+                finally {
+                    retriever.release();
+                }
+            }
+
+            BitmapFactory.Options bounds = new BitmapFactory.Options();
+            bounds.inJustDecodeBounds = true;
+            InputStream in = context.getContentResolver().openInputStream(uri);
+            if (in == null) {
+                return null;
+            }
+            try {
+                BitmapFactory.decodeStream(in, null, bounds);
+            }
+            finally {
+                in.close();
+            }
+            int big = Math.max(bounds.outWidth, bounds.outHeight);
+            if (big <= 0) {
+                return null;
+            }
+            BitmapFactory.Options options = new BitmapFactory.Options();
+            options.inSampleSize = Math.max(1, big / Math.max(1, targetSide));
+            in = context.getContentResolver().openInputStream(uri);
+            if (in == null) {
+                return null;
+            }
+            try {
+                return BitmapFactory.decodeStream(in, null, options);
+            }
+            finally {
+                in.close();
+            }
+        }
+        catch (Throwable t) {
+            // Missing file, revoked permission, unsupported codec, out of memory...
+            return null;
+        }
+    }
+}
diff --git a/app/src/main/java/com/limelight/aero/AeroWallpaperView.java b/app/src/main/java/com/limelight/aero/AeroWallpaperView.java
new file mode 100644
index 0000000..37a96a6
--- /dev/null
+++ b/app/src/main/java/com/limelight/aero/AeroWallpaperView.java
@@ -0,0 +1,269 @@
+package com.limelight.aero;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Color;
+import android.graphics.Matrix;
+import android.graphics.SurfaceTexture;
+import android.graphics.drawable.BitmapDrawable;
+import android.graphics.drawable.Drawable;
+import android.media.MediaPlayer;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.Surface;
+import android.view.TextureView;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+
+/**
+ * The wallpaper layer: a still image, an animated GIF / WebP (Android 9+; older versions show the
+ * first frame) or a looping silent video, cropped to fill the screen and darkened by the dim setting.
+ * It pauses while its window is not focused, so it costs nothing while streaming, and if the file
+ * cannot be shown it stays transparent, leaving the sky visible.
+ */
+final class AeroWallpaperView extends FrameLayout implements TextureView.SurfaceTextureListener {
+    private static final int MAX_IMAGE_SIDE = 2048;
+
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final ImageView image;
+    private final View dim;
+
+    private Uri uri;
+    private int load = 0;
+    private Drawable drawable;
+    private TextureView texture;
+    private MediaPlayer player;
+    private boolean playerReady;
+    private int videoWidth;
+    private int videoHeight;
+
+    AeroWallpaperView(Context context) {
+        super(context);
+        image = new ImageView(context);
+        image.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        addView(image, new LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        dim = new View(context);
+        addView(dim, new LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+    }
+
+    void setSource(Uri newUri, float dimAmount) {
+        dim.setBackgroundColor(Color.argb(Math.round(Math.max(0f, Math.min(1f, dimAmount)) * 255f), 0, 0, 0));
+        if (newUri.equals(uri)) {
+            return;
+        }
+        uri = newUri;
+        reload();
+    }
+
+    private void reload() {
+        release();
+        if (uri == null) {
+            return;
+        }
+        final int mine = ++load;
+        final Context context = getContext().getApplicationContext();
+        final Uri source = uri;
+        new Thread(new Runnable() {
+            @Override
+            public void run() {
+                final boolean video = AeroWallpaper.isVideo(context, source);
+                Drawable decoded = null;
+                if (!video) {
+                    try {
+                        if (Build.VERSION.SDK_INT >= 28) {
+                            decoded = AeroApi28.decode(context.getContentResolver(), source, MAX_IMAGE_SIDE);
+                        }
+                        else {
+                            Bitmap bitmap = AeroWallpaper.loadStill(context, source, MAX_IMAGE_SIDE);
+                            if (bitmap != null) {
+                                decoded = new BitmapDrawable(context.getResources(), bitmap);
+                            }
+                        }
+                    }
+                    catch (Throwable t) {
+                        decoded = null;
+                    }
+                }
+                final Drawable result = decoded;
+                main.post(new Runnable() {
+                    @Override
+                    public void run() {
+                        if (mine != load) {
+                            return;
+                        }
+                        if (video) {
+                            startVideo();
+                        }
+                        else if (result != null) {
+                            drawable = result;
+                            image.setImageDrawable(result);
+                            updatePlaying();
+                        }
+                    }
+                });
+            }
+        }, "aero-wallpaper").start();
+    }
+
+    // ------------------------------------------------------------------ video
+
+    private void startVideo() {
+        if (texture != null) {
+            return;
+        }
+        texture = new TextureView(getContext());
+        texture.setSurfaceTextureListener(this);
+        addView(texture, 1, new LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+    }
+
+    @Override
+    public void onSurfaceTextureAvailable(SurfaceTexture surfaceTexture, int width, int height) {
+        if (uri == null || player != null) {
+            return;
+        }
+        try {
+            player = new MediaPlayer();
+            player.setSurface(new Surface(surfaceTexture));
+            player.setDataSource(getContext(), uri);
+            player.setLooping(true);
+            player.setVolume(0f, 0f);
+            player.setOnVideoSizeChangedListener(new MediaPlayer.OnVideoSizeChangedListener() {
+                @Override
+                public void onVideoSizeChanged(MediaPlayer mp, int width, int height) {
+                    videoWidth = width;
+                    videoHeight = height;
+                    applyCrop();
+                }
+            });
+            player.setOnPreparedListener(new MediaPlayer.OnPreparedListener() {
+                @Override
+                public void onPrepared(MediaPlayer mp) {
+                    playerReady = true;
+                    updatePlaying();
+                }
+            });
+            player.setOnErrorListener(new MediaPlayer.OnErrorListener() {
+                @Override
+                public boolean onError(MediaPlayer mp, int what, int extra) {
+                    // Unsupported codec or file gone: fall back to the sky
+                    release();
+                    return true;
+                }
+            });
+            player.prepareAsync();
+        }
+        catch (Throwable t) {
+            release();
+        }
+    }
+
+    @Override
+    public void onSurfaceTextureSizeChanged(SurfaceTexture surface, int width, int height) {
+        applyCrop();
+    }
+
+    @Override
+    public boolean onSurfaceTextureDestroyed(SurfaceTexture surface) {
+        if (player != null) {
+            try {
+                player.release();
+            }
+            catch (Throwable ignored) {
+            }
+            player = null;
+            playerReady = false;
+        }
+        return true;
+    }
+
+    @Override
+    public void onSurfaceTextureUpdated(SurfaceTexture surface) {
+    }
+
+    /** TextureView stretches the video to fill itself; undo that and crop instead. */
+    private void applyCrop() {
+        if (texture == null || videoWidth <= 0 || videoHeight <= 0 || getWidth() <= 0 || getHeight() <= 0) {
+            return;
+        }
+        float viewW = getWidth();
+        float viewH = getHeight();
+        float scale = Math.max(viewW / videoWidth, viewH / videoHeight);
+        Matrix matrix = new Matrix();
+        matrix.setScale(videoWidth * scale / viewW, videoHeight * scale / viewH, viewW / 2f, viewH / 2f);
+        texture.setTransform(matrix);
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        super.onSizeChanged(w, h, oldw, oldh);
+        applyCrop();
+    }
+
+    // ------------------------------------------------------------------ lifecycle
+
+    private void updatePlaying() {
+        boolean run = hasWindowFocus() && isAttachedToWindow();
+        if (player != null && playerReady) {
+            try {
+                if (run && !player.isPlaying()) {
+                    player.start();
+                }
+                else if (!run && player.isPlaying()) {
+                    player.pause();
+                }
+            }
+            catch (Throwable ignored) {
+            }
+        }
+        if (drawable != null && Build.VERSION.SDK_INT >= 28) {
+            AeroApi28.setPlaying(drawable, run);
+        }
+    }
+
+    @Override
+    public void onWindowFocusChanged(boolean hasWindowFocus) {
+        super.onWindowFocusChanged(hasWindowFocus);
+        updatePlaying();
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        if (uri != null && drawable == null && texture == null) {
+            reload();
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        super.onDetachedFromWindow();
+        release();
+    }
+
+    private void release() {
+        load++;
+        if (player != null) {
+            try {
+                player.release();
+            }
+            catch (Throwable ignored) {
+            }
+            player = null;
+        }
+        playerReady = false;
+        if (texture != null) {
+            texture.setSurfaceTextureListener(null);
+            removeView(texture);
+            texture = null;
+        }
+        if (drawable != null && Build.VERSION.SDK_INT >= 28) {
+            AeroApi28.setPlaying(drawable, false);
+        }
+        drawable = null;
+        image.setImageDrawable(null);
+    }
+}
